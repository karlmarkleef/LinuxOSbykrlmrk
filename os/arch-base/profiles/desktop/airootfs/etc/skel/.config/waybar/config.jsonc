{
  "layer": "top", "position": "top", "height": 34, "spacing": 4,
  "modules-left": ["custom/brand", "hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["clock", "custom/quick", "network", "pulseaudio", "tray"],
  "custom/brand": { "format": "  Mark Linux", "tooltip": "Open Mark Linux Welcome", "on-click": "mark-welcome" },
  "hyprland/workspaces": { "format": "{id}", "persistent-workspaces": { "*": 5 }, "on-click": "activate" },
  "hyprland/window": { "max-length": 54, "separate-outputs": true },
  "clock": { "format": "{:%a  %d %b  %H:%M}", "tooltip-format": "{:%A, %d %B %Y}" },
  "network": { "format-wifi": "  {essid}", "format-ethernet": "󰈀  Wired", "format-disconnected": "󰤮  Offline", "tooltip-format": "{ifname}: {ipaddr}", "on-click": "nm-connection-editor" },
  "pulseaudio": { "format": "  {volume}%", "format-muted": "  Muted", "on-click": "pavucontrol" },
  "tray": { "spacing": 6 },
  "custom/quick": { "format": "  Control Center", "tooltip": "Open Quick Settings Control Center", "on-click": "mark-quick-settings" },
  "custom/effects": { "exec": "mark-effects-toggle --status", "return-type": "json", "interval": "once", "signal": 8, "on-click": "mark-effects-toggle --toggle" }
}
